# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Configuration files with API keys
# NOTE: config.py itself may be committed ONLY when it contains NO secrets
# and loads credentials via python-dotenv / environment variables.
# .env files MUST NEVER be committed.
.env
.env.*
!.env.example

# Instaloader session files / credentials
instagram_session
*_session

# Logs
*.log
reports.log

# IDE
.vscode/
.idea/
.trae/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# ------------------------------
# Project-specific additions
# ------------------------------

# Trained ML models, calibrators, pickled pipelines
models/**/*.joblib
models/**/*.pkl
models/**/*.pickle
!models/v1/model_pipeline.joblib
!models/v1/calibrated_pipeline.joblib

# FAISS vector index
genai/rag/faiss_index.bin
genai/rag/*.index

# Downloaded datasets - do not commit raw Kaggle data
# Instead, document sources in data/README.md
data/kaggle_bakhshandeh/
data/**/*.zip
!data/**/README*

# Generated reports (images / CSVs) — optionally commit after tagging a release
reports/*.png
reports/*.csv
reports/*.txt
reports/*.html

# Local pytest cache
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Jupyter notebooks checkpoints / outputs
.ipynb_checkpoints
.ipynb_outputs/

# HuggingFace / sentence-transformers local cache
.cache/
