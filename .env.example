# ============================================================
# .env.example — Suspicious Account Risk Assessment System
# ============================================================
# Copy this file to `.env` and fill in values.
# `.env` is in .gitignore — NEVER commit `.env`.

# ------------------------------------------------------------
# INSTAGRAM / FACEBOOK APIs (optional — leave blank for mock mode)
# ------------------------------------------------------------
INSTAGRAM_GRAPH_API_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_USER_ID=

INSTAGRAM_BASIC_DISPLAY_CLIENT_ID=
INSTAGRAM_BASIC_DISPLAY_CLIENT_SECRET=
INSTAGRAM_BASIC_DISPLAY_ACCESS_TOKEN=

INSTALOADER_USERNAME=
INSTALOADER_PASSWORD=
INSTALOADER_USE_SESSION_FILE=True

FACEBOOK_GRAPH_API_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_APP_ID=
FACEBOOK_GRAPH_API_APP_SECRET=

# Leave as 'mock' unless you want real API calls. Options: mock | instaloader | graph_api
API_METHOD=mock
USE_REAL_API=False

# ------------------------------------------------------------
# DETECTION / MODEL CONFIG
# ------------------------------------------------------------
MODEL_VERSION=v1
DETECTION_THRESHOLD=0.50
RISK_LEVEL_HIGH=0.70
RISK_LEVEL_MEDIUM=0.40

# ------------------------------------------------------------
# GENAI CONFIG (optional — leave PROVIDER=none to disable)
# ------------------------------------------------------------
# Options: none | openai | ollama
GENAI_PROVIDER=none
OPENAI_API_KEY=
GENAI_MODEL_NAME=gpt-4o-mini
GENAI_TIMEOUT_SECONDS=15
GENAI_MAX_RETRIES=1

# ------------------------------------------------------------
# RAG CONFIG
# ------------------------------------------------------------
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=3
RAG_INDEX_PATH=genai/rag/faiss_index.bin

# ------------------------------------------------------------
# FLASK / SERVER
# ------------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
DEBUG=False
RATE_LIMIT_PER_MINUTE=30
